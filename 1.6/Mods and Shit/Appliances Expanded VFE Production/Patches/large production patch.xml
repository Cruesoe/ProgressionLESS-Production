<?xml version="1.0" encoding="utf-8" ?>
<Patch>

	<Operation Class="PatchOperationRemove">
		<xpath>Defs/ThingDef[defName="CA_ChemfuelStoveLarge"]/researchPrerequisites/li[text()="VFE_Manufacturing"]</xpath>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="CE_FueledSmithyLarge"]/researchPrerequisites</xpath>
		<value>
			<researchPrerequisites>
				<li>VFE_Manufacturing</li>
				<li>Smithing</li>
				<li MayRequire="ferny.generallymoreresearch">Ferny_ChemfuelLogistics</li>
				<li MayRequire="dankpyon.medieval.overhaul">Ferny_IndustrialSmithing</li>
			</researchPrerequisites>
		</value>
	</Operation>

</Patch>
