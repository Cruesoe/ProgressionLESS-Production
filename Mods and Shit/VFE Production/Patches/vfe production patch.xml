<?xml version="1.0" encoding="utf-8"?>
<Patch>


<!-- LARGE MACHINING TABLE -->

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ResearchProjectDef[defName="VFE_Manufacturing"]/label</xpath>
		<value>
			<label>Large machining table</label>
		</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ResearchProjectDef[defName="VFE_Manufacturing"]/description</xpath>
		<value>
			<description>Build a large machining table for faster machining work.</description>
		</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ResearchProjectDef[defName="VFE_Manufacturing"]/baseCost</xpath>
		<value>
			<baseCost>1500</baseCost>
		</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ResearchProjectDef[defName="VFE_Manufacturing"]/prerequisites</xpath>
		<value>
			<prerequisites>
				<li>Fabrication</li>
				<li>Machining</li>
			</prerequisites>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="VFE_TableMachiningLarge"]/researchPrerequisites</xpath>
		<value>
			<researchPrerequisites>
				<li>VFE_Manufacturing</li>
			</researchPrerequisites>
		</value>
	</Operation>

	<Operation Class="PatchOperationRemove">
		<xpath>Defs/ThingDef[defName="VFE_TableStoveLarge"]/researchPrerequisites/li[text()="VFE_Manufacturing"]</xpath>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="VFE_TableSmithyLarge"]/researchPrerequisites</xpath>
		<value>
			<researchPrerequisites>
				<li>Ferny_LargeElectricSmithy</li>
			</researchPrerequisites>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="VFE_TableTailorLarge"]/researchPrerequisites</xpath>
		<value>
			<researchPrerequisites>
				<li>Ferny_LargeTailoringTable</li>
			</researchPrerequisites>
		</value>
	</Operation>

<!-- NEW RESEARCH PROJECTS -->

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="VFE_FueledSmelter"]/researchPrerequisites</xpath>
		<value>
			<researchPrerequisites>
				<li>Ferny_FueledSmelter</li>
			</researchPrerequisites>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="VFE_TableStonecutterElectric"]/researchPrerequisites</xpath>
		<value>
			<researchPrerequisites>
				<li>Ferny_ElectricStonecuttersTable</li>
			</researchPrerequisites>
		</value>
	</Operation>

</Patch>
